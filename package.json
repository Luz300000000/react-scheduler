{
  "name": "@luz300000000/react-scheduler",
  "version": "4.0.31",
  "description": "React scheduler component based on Material-UI & date-fns",
  "files": [
    "*"
  ],
  "type": "module",
  "scripts": {
    "start": "vite serve",
    "build": "vite build --mode production",
    "postbuild": "node ./scripts/post-pack.js",
    "local:pack": "npm run build && cd dist && npm pack && mv *.tgz ../",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\"",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "npm run types && eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit",
    "pre:commit": "lint-staged",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci"
  },
  "exports": {
    "./types": {
      "import": "./types.d.ts"
    },
    ".": {
      "import": "./index.js"
    }
  },
  "lint-staged": {
    "**/*.{ts,js,tsx,jsx}": [
      "npm run lint"
    ],
    "**/*.{ts,js,tsx,jsx,json,yml}": [
      "npm run format:write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luz300000000/react-scheduler.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react",
    "material-ui",
    "calendar",
    "scheduler"
  ],
  "author": "Luz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Luz300000000/react-scheduler/issues"
  },
  "devDependencies": {
    "@emotion/styled": "^11.14.1",
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-peer-deps-external": "2.2.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "date-fns": ">=4.1.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react": ">=19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rrule": "^2.8.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "date-fns": ">=4.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=18.0.0",
    "rrule": ">=2.8.1"
  },
  "peerDependenciesMeta": {
    "rrule": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "fix": "^0.0.6"
  }
}
